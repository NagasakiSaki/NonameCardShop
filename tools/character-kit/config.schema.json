{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-kit-config/1.0",
  "title": "Existing character-art configuration input",
  "anyOf": [
    {"$ref": "#/$defs/config"},
    {"$ref": "#/$defs/configs"},
    {"type": "object", "required": ["presets"], "properties": {"presets": {"$ref": "#/$defs/configs"}}},
    {"type": "object", "required": ["portrait"], "properties": {"portrait": {"$ref": "#/$defs/config"}}}
  ],
  "$defs": {
    "palette": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
    "part": {"type": "string", "pattern": "^[a-zA-Z0-9-]+$"},
    "configs": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/config"}},
    "config": {
      "type": "object",
      "required": ["id", "base", "front", "back", "clothes", "eyes", "mouth", "hair", "cloth", "iris"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "base": {"$ref": "#/$defs/part"}, "front": {"$ref": "#/$defs/part"},
        "back": {"$ref": "#/$defs/part"}, "clothes": {"$ref": "#/$defs/part"},
        "eyes": {"$ref": "#/$defs/part"}, "mouth": {"$ref": "#/$defs/part"}, "walkHair": {"$ref": "#/$defs/part"},
        "hair": {"$ref": "#/$defs/palette"}, "cloth": {"$ref": "#/$defs/palette"}, "iris": {"$ref": "#/$defs/palette"},
        "secondary": {"$ref": "#/$defs/palette"}, "otherEye": {"$ref": "#/$defs/palette"},
        "originalCloth": {"$ref": "#/$defs/palette"}, "shoePalette": {"$ref": "#/$defs/palette"}, "sleevePalette": {"$ref": "#/$defs/palette"},
        "streak": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "walkTailLength": {"type": "integer", "minimum": 0, "maximum": 40},
        "band": {"enum": ["mygo", "avemujica", "yumemita", "millsage", "ikka-dumb-rock"]},
        "costume": {"type": "string", "description": "Existing portrait costume ID from data/character-audit.mjs; checked by the CLI."},
        "walkCostume": {"type": "string", "description": "Optional registered refined walk costume; checked by the CLI."},
        "walkInnerColor": {"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
        "walkSkirtColor": {"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
        "walkTrimColor": {"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
        "walkHoodColor": {"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
        "walkSleeveStripe": {"type":"string","pattern":"^#[0-9a-fA-F]{6}$"}
      },
      "if": {"required": ["band"]},
      "then": {"required": ["costume"]},
      "else": {"required": ["walkHair"]},
      "additionalProperties": true
    }
  }
}
