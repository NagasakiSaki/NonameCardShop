{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"中立单挑与KOF武将强度估算 v1",
  "type":"object",
  "required":["version","baseline","pointsPerCE","hpPoint","weights","assumptions","rarityThresholds","overrides"],
  "properties":{
    "version":{"const":1},"baseline":{"type":"number"},"pointsPerCE":{"type":"number","exclusiveMinimum":0},"hpPoint":{"type":"number","minimum":0},
    "legendRequiresReview":{"type":"boolean","description":"未做逐将规则校准的UR候选先保留SR"},
    "weights":{"type":"object","required":["damage","guard","heal","control","quality","hpLoss","burst","carry"],"additionalProperties":{"type":"number","minimum":0}},
    "assumptions":{"type":"object","required":["turnsPerGeneral","damageEvents","damageDealtEvents","cardEvents","conditional","perSkillCap","perGeneralCap","uncertainDiscount","hpCap"],"additionalProperties":{"type":"number","minimum":0}},
    "rarityThresholds":{"type":"object","required":["U","R","SR","UR"],"additionalProperties":{"type":"number"}},
    "overrides":{"type":"object","additionalProperties":{"type":"object","required":["vector","confidence","notes"],"properties":{"vector":{"type":"object","propertyNames":{"enum":["cards","damage","guard","heal","control","quality","cost","hpLoss","burst","carry"]},"additionalProperties":{"type":"number","minimum":0}},"confidence":{"type":"number","minimum":0,"maximum":1},"notes":{"type":"string","minLength":1}}}}
  }
}
