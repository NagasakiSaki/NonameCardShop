{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "无名小店任务配置 v1",
  "type": "object",
  "required": [
    "version",
    "tasks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "scope",
          "objectives",
          "rewards"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 800
          },
          "scope": {
            "enum": [
              "once",
              "daily"
            ]
          },
          "mode": {
            "enum": [
              "all",
              "any"
            ]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "deadlineMinute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1439
          },
          "guide": {
            "enum": [
              "counter",
              "display",
              "trash",
              "battle"
            ]
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "type",
                "target"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "metric",
                    "event"
                  ]
                },
                "metric": {
                  "type": "string"
                },
                "event": {
                  "type": "string"
                },
                "measure": {
                  "enum": [
                    "amount",
                    "quantity"
                  ]
                },
                "target": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "const": "dailyRevenueGoal"
                    }
                  ]
                },
                "filter": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      }
                    ]
                  }
                },
                "window": {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1439
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1440
                    }
                  },
                  "additionalProperties": false
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "metric"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "metric"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "event"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "event"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "rewards": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "amount": {
                  "type": "integer",
                  "minimum": 0
                },
                "packId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}