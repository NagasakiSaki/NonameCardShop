      "scope": "once",
      "dependsOn": [
        "put_on_shelf"
      ],
      "objectives": [
        {
          "type": "metric",
          "metric": "lifetime.served",
          "target": 3
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 100
        },
        {
          "type": "reputation",
          "amount": 2
        }
      ],
      "guide": "display"
    },
    {
      "id": "daily_revenue",
      "title": "今日营业额目标",
