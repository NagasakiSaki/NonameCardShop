      "scope": "daily",
      "objectives": [
        {
          "type": "metric",
          "metric": "daily.revenue",
          "target": "dailyRevenueGoal"
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 80
        },
        {
          "type": "reputation",
          "amount": 2
        }
      ]
    },
    {
      "id": "morning_sale",
      "title": "午后之前开个好头",
      "description": "09:00—13:00 之间取得 ¥60 营业额。",
      "scope": "daily",
      "deadlineMinute": 780,
      "objectives": [
        {
          "type": "event",
          "event": "sale",
          "measure": "amount",
          "window": {
            "from": 540,
            "to": 780
          },
          "target": 60
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 35
        }
      ]
    },
    {
      "id": "daily_packs",
      "title": "整包也有人喜欢",
      "description": "今天卖出 2 个未拆封卡包。",
      "scope": "daily",
      "objectives": [
        {
          "type": "event",
          "event": "sale",
          "filter": {
            "kind": "pack"
          },
          "target": 2
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 35
        }
      ],
      "guide": "display"
    },
    {
      "id": "evening_collector",
      "title": "晚间收藏客",
      "description": "17:00—20:00 卖出 1 张 R / SR / UR 单卡。",
      "scope": "daily",
      "conditions": [
        {
          "type": "minDay",
          "value": 2
        }
      ],
      "objectives": [
        {
          "type": "event",
          "event": "sale",
          "filter": {
            "kind": "card",
            "rarity": [
              "R",
              "SR",
              "UR"
            ]
          },
          "window": {
            "from": 1020,
            "to": 1200
          },
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 60
        }
      ]
    },
    {
      "id": "first_card_purchase",
      "title": "街坊的旧收藏",
      "description": "在街坊与经营手账中，购买一份指定单卡收购申请。",
      "scope": "once",
      "objectives": [
        {
          "type": "event",
          "event": "cardPurchased",
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 20
        }
      ],
      "guide": "counter"
    },
    {
      "id": "first_customer_request",
      "title": "帮街坊找一张卡",
