{
  "$schema": "./tasks.schema.json",
  "version": 1,
  "tasks": [
    {
      "id": "first_order",
      "title": "第一次进货",
      "description": "在柜台向供应商订购至少 3 包卡。",
      "scope": "once",
      "objectives": [
        {
          "type": "metric",
          "metric": "lifetime.purchasedPacks",
          "target": 3
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 40
        }
      ],
      "guide": "counter"
    },
    {
      "id": "receive_stock",
      "title": "货到了，签收吧",
      "description": "等待送货，在柜台仓库签收 3 包卡。",
      "scope": "once",
      "dependsOn": [
        "first_order"
      ],
      "objectives": [
        {
          "type": "metric",
          "metric": "lifetime.receivedPacks",
          "target": 3
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 40
        }
      ],
      "guide": "counter"
    },
    {
      "id": "put_on_shelf",
      "title": "让货架有得卖",
      "description": "累计上架 2 件商品，可以是整包或单卡。",
      "scope": "once",
      "dependsOn": [
        "receive_stock"
      ],
      "objectives": [
        {
          "type": "metric",
          "metric": "lifetime.listedUnits",
          "target": 2
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 50
        }
      ],
      "guide": "display"
    },
    {
      "id": "first_customers",
      "title": "迎接三位顾客",
