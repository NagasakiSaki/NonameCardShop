      "scope": "once",
      "objectives": [
        {
          "type": "metric",
          "metric": "management.ordersCompleted",
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 60
        },
        {
          "type": "reputation",
          "amount": 1
        }
      ],
      "guide": "counter"
    },
    {
      "id": "first_collection_lock",
      "title": "这张留给自己",
