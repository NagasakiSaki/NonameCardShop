      "scope": "once",
      "objectives": [
        {
          "type": "event",
          "event": "collectionLockChanged",
          "filter": {
            "quantity": 1
          },
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 10
        }
      ]
    },
    {
      "id": "first_store_upgrade",
      "title": "小店长大一点",
      "description": "购买一项设施或雇用一名员工。",
      "scope": "once",
      "objectives": [
        {
          "type": "metric",
          "metric": "management.upgradeLevels",
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 50
        }
      ]
    },
    {
      "id": "first_relay",
      "title": "轮到下一位了",
      "description": "在 KOF 对局中，自己的接班武将登场一次。",
      "scope": "once",
      "objectives": [
        {
          "type": "event",
          "event": "generalReplaced",
          "filter": {
            "side": "mine"
          },
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 30
        }
      ],
      "guide": "battle"
    },
    {
      "id": "first_bo3_win",
      "title": "三局两胜",
      "description": "赢下一整场 BO3；单局获胜尚不计完成。",
      "scope": "once",
      "objectives": [
        {
          "type": "event",
          "event": "matchFinished",
          "filter": {
            "mode": "bo3",
            "result": "win"
          },
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 60
        }
      ],
      "guide": "battle"
    },
    {
      "id": "first_weekly_champion",
      "title": "街坊店赛冠军",
      "description": "购买店赛牌桌后，在周日赢得 KOF 店赛。",
      "scope": "once",
      "objectives": [
        {
          "type": "event",
          "event": "matchFinished",
          "filter": {
            "mode": "kof",
            "ranked": true,
            "result": "win"
          },
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 100
        },
        {
          "type": "reputation",
          "amount": 3
        }
      ],
      "guide": "battle"
    },
    {
      "id": "daily_regular_order",
      "title": "今日预约交付",
      "description": "今天完成一份街坊预约，获得额外奖励。",
      "scope": "daily",
      "objectives": [
        {
          "type": "event",
          "event": "customerOrderCompleted",
          "target": 1
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 25
        }
      ],
      "guide": "counter"
    }
