{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "无名小店经营配置 v1",
  "type": "object",
  "required": [
    "version",
    "clock",
    "economy",
    "supplier",
    "customers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "clock": {
      "type": "object",
      "required": [
        "prepareMinute",
        "openMinute",
        "closeMinute",
        "minutesPerSecond",
        "speeds"
      ],
      "properties": {
        "prepareMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "openMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "closeMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "minutesPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "speeds": {
          "type": "array",
          "uniqueItems": true,
          "contains": {
            "const": 1
          },
          "items": {
            "enum": [
              1,
              2,
              4
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "economy": {
      "type": "object",
      "required": [
        "startingCash",
        "baseDailyGoal",
        "dailyGoalStep",
        "maxDailyGoal",
        "operatingCost",
        "supplierCreditLimit",
        "shelfCapacity",
        "wholesaleByTier",
        "retailPackByTier",
        "cardPrices"
      ],
      "properties": {
        "startingCash": {
          "type": "integer",
          "minimum": 0
        },
        "baseDailyGoal": {
          "type": "integer",
          "minimum": 0
        },
        "dailyGoalStep": {
          "type": "integer",
          "minimum": 0
        },
        "maxDailyGoal": {
          "type": "integer",
          "minimum": 0
        },
        "operatingCost": {
          "type": "integer",
          "minimum": 0
        },
        "supplierCreditLimit": {
          "type": "integer",
          "minimum": 0
        },
        "shelfCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "wholesaleByTier": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3",
            "4"
          ],
          "properties": {
            "1": {
              "type": "integer",
              "minimum": 1
            },
            "2": {
              "type": "integer",
              "minimum": 1
            },
            "3": {
              "type": "integer",
              "minimum": 1
            },
            "4": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "retailPackByTier": {
          "type": "object",
          "required": [
            "1",
            "2",
            "3",
            "4"
          ],
          "properties": {
            "1": {
              "type": "integer",
              "minimum": 1
            },
            "2": {
              "type": "integer",
              "minimum": 1
            },
            "3": {
              "type": "integer",
              "minimum": 1
            },
            "4": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "cardPrices": {
          "type": "object",
          "required": [
            "C",
            "U",
            "R",
            "SR",
            "UR"
          ],
          "properties": {
            "C": {
              "type": "integer",
              "minimum": 1
            },
            "U": {
              "type": "integer",
              "minimum": 1
            },
            "R": {
              "type": "integer",
              "minimum": 1
            },
            "SR": {
              "type": "integer",
              "minimum": 1
            },
            "UR": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "supplier": {
      "type": "object",
      "required": [
        "deliveryMinutes",
        "maxOrderQuantity"
      ],
      "properties": {
        "deliveryMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "maxOrderQuantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "customers": {
      "type": "object",
      "required": [
        "intervalMinutes",
        "maxConcurrent",
        "shoppingSeconds",
        "traffic",
        "profiles"
      ],
      "properties": {
        "intervalMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 240
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "shoppingSeconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "traffic": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "multiplier"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1439
              },
              "to": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1440
              },
              "multiplier": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 5
              }
            },
            "additionalProperties": false
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "weight",
              "budget",
              "preference",
              "rarities",
              "maxMarkup",
              "tint"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 39
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "budget": {
                "type": "integer",
                "minimum": 1
              },
              "preference": {
                "enum": [
                  "pack",
                  "card",
                  "cheapest"
                ]
              },
              "rarities": {
                "type": "array",
                "items": {
                  "enum": [
                    "C",
                    "U",
                    "R",
                    "SR",
                    "UR"
                  ]
                }
              },
              "maxMarkup": {
                "type": "number",
                "minimum": 0.6,
                "maximum": 2
              },
              "tint": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777215
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}