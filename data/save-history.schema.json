  "properties":{
    "version":{"const":1},
    "maxDaysPerCampaign":{"type":"integer","minimum":1,"maximum":365},
    "maxBeforeLoadBackups":{"type":"integer","minimum":1,"maximum":100}
  },
  "additionalProperties":false
}
